@page "/"

@inject SalonDataService Data

<h1>Test</h1>

@if (services is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <p>@services.Count hizmet yüklendi.</p>
}

@code {
    private List<SalonService>? services;

    protected override async Task OnInitializedAsync()
    {
        services = await Data.GetServicesAsync();
    }
}
